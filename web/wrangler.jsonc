{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "noteai-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "secrets": {
    "required": [
      "TURSO_DATABASE_URL",
      "TURSO_AUTH_TOKEN",
      "NOTEAI_AUTH_SECRET",
      "GOOGLE_CLIENT_ID"
    ]
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "STATIC_ASSETS"
  },
  "env": {
    "preview": {
      "workers_dev": true,
      "observability": {
        "enabled": true,
        "head_sampling_rate": 0.1
      },
      "secrets": {
        "required": [
          "TURSO_DATABASE_URL",
          "TURSO_AUTH_TOKEN",
          "NOTEAI_AUTH_SECRET",
          "GOOGLE_CLIENT_ID"
        ]
      }
    }
  }
}
