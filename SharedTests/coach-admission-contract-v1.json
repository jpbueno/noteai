{
  "name": "coach-admission-contract-v1",
  "schema_version": 1,
  "contract": {
    "case_exact_keys": ["id", "model_output", "transcript_segments", "expected"],
    "transcript_segment_exact_keys": ["source_segment_id", "text"],
    "envelope": {
      "exact_keys": ["contract_version", "candidates"],
      "contract_version": 1,
      "max_candidates": 2
    },
    "candidate_union": {
      "discriminator": "kind",
      "guidance_question": {
        "kind": "guidance_question",
        "exact_keys": ["kind", "directive", "question", "priority", "topic"],
        "directives": ["ask", "clarify", "confirm", "check", "probe", "compare", "validate", "quantify", "discuss", "explore"],
        "derived_type": "talking_point",
        "derived_basis": "recommendation",
        "derived_content": "<Capitalized directive>: <normalized question>",
        "question_rule": "One normalized interrogative ending in exactly one question mark, with no earlier sentence terminator, newline, semicolon, control, bidi, or unsafe invisible character."
      },
      "transcript_quote": {
        "kind": "transcript_quote",
        "exact_keys": ["kind", "presentation", "evidence_quotes", "priority", "topic"],
        "evidence_quote_exact_keys": ["source_segment_id", "quote"],
        "presentations": {
          "observation": {
            "type": "key_insight",
            "basis": "transcript",
            "content_prefix": "Transcript quote: "
          },
          "possible_action": {
            "type": "action_item",
            "basis": "transcript",
            "content_prefix": "Possible action: "
          },
          "possible_follow_up": {
            "type": "follow_up",
            "basis": "transcript",
            "content_prefix": "Possible follow-up: "
          }
        },
        "evidence_rule": "Every quote equals one complete normalized source segment. Multiple quotes have identical normalized text and distinct valid source IDs."
      }
    },
    "priorities": ["high", "critical"],
    "topic_rule": {
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "max_characters": 64
    },
    "normalization": {
      "text_steps": ["NFC", "trim Unicode whitespace", "collapse Unicode whitespace runs to U+0020"],
      "comparison": "exact after normalization",
      "reject": ["control characters", "bidi controls", "unsafe invisible characters"]
    },
    "derived_limits": {
      "max_characters": 180,
      "max_words": 24
    },
    "expected_result": {
      "exact_keys": ["outcome", "derived", "rejection_category", "side_effects"],
      "derived_exact_keys": ["content", "type", "basis", "evidence_ids", "topic", "priority"],
      "side_effect_exact_keys": ["task_creations", "tool_calls"]
    },
    "rejection_categories": [
      "invalid_envelope",
      "unsupported_version",
      "too_many_candidates",
      "invalid_candidate",
      "invalid_text",
      "invalid_topic",
      "invalid_evidence"
    ]
  },
