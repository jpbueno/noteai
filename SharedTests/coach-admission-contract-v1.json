{
  "name": "coach-admission-contract-v1",
  "schema_version": 1,
  "contract": {
    "case_exact_keys": [
      "id",
      "model_output",
      "transcript_segments",
      "expected"
    ],
    "transcript_segment_exact_keys": [
      "source_segment_id",
      "text"
    ],
    "envelope": {
      "exact_keys": [
        "contract_version",
        "candidates"
      ],
      "contract_version": 1,
      "max_candidates": 2
    },
    "candidate_union": {
      "discriminator": "kind",
      "guidance": {
        "kind": "guidance",
        "exact_keys": [
          "kind",
          "directive",
          "body",
          "priority",
          "topic"
        ],
        "directive_mappings": [
          {
            "directive": "ask",
            "type": "talking_point",
            "basis": "recommendation"
          },
          {
            "directive": "answer",
            "type": "technical_answer",
            "basis": "domain_knowledge"
          },
          {
            "directive": "recommend",
            "type": "key_insight",
            "basis": "recommendation"
          },
          {
            "directive": "investigate",
            "type": "follow_up",
            "basis": "recommendation"
          }
        ],
        "content_source": "normalized body",
        "body_rule": "One sentence with no control or bidi characters and no unqualified commitment claim."
      },
      "transcript_quote": {
        "kind": "transcript_quote",
        "exact_keys": [
          "kind",
          "presentation",
          "evidence_quotes",
          "priority",
          "topic"
        ],
        "evidence_quote_exact_keys": [
          "source_segment_id",
          "quote"
        ],
        "presentation_mappings": [
          {
            "presentation": "observation",
            "type": "key_insight",
            "basis": "transcript",
            "requires": "complete transcript quote"
          },
          {
            "presentation": "action_item",
            "type": "action_item",
            "basis": "transcript",
            "requires": "complete affirmative commitment quote"
          },
          {
            "presentation": "follow_up",
            "type": "follow_up",
            "basis": "transcript",
            "requires": "complete explicit follow-up quote"
          }
        ],
        "content_source": "shared normalized evidence quote",
        "evidence_rule": "Each quote must equal one complete normalized source segment. Multiple quotes must normalize to the same text and use distinct source IDs."
      }
    },
    "priorities": [
      "high",
      "critical"
    ],
    "normalization": {
      "text_steps": [
        "NFC",
        "trim Unicode whitespace",
        "collapse Unicode whitespace runs to U+0020"
      ],
      "comparison": "exact after normalization"
    },
    "expected_result": {
      "exact_keys": [
        "outcome",
        "derived",
        "rejection_category",
        "side_effects"
      ],
      "derived_exact_keys": [
        "content",
        "type",
        "basis",
        "evidence_ids"
      ],
      "side_effect_exact_keys": [
        "task_creations",
        "tool_calls"
      ]
    },
    "rejection_categories": [
      "invalid_envelope",
      "unsupported_version",
      "too_many_candidates",
      "invalid_candidate",
      "invalid_text",
      "unsafe_guidance",
      "invalid_evidence",
      "presentation_mismatch"
    ]
  },
